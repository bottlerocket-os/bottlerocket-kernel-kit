[Unit]
Description=NVIDIA IMEX service
After=network-online.target
Requires=network-online.target
# nvidia-imex and its /etc/nvidia-imex config come from the branch overlays;
# order after both branches' overlays (absent branch is a no-op).
After=nvidia-lts-overlay-driver.service nvidia-pb-overlay-driver.service
After=nvidia-lts-overlay-config.service nvidia-pb-overlay-config.service

[Service]
Type=simple
ExecStart=/usr/bin/nvidia-imex -c /etc/nvidia-imex/config.cfg
StandardOutput=journal
StandardError=journal
LimitCORE=infinity
