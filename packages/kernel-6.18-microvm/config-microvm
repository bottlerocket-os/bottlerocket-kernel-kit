# Kernel configuration overrides for the microvm flavor.
#
# This flavor targets microvm guests (e.g., Firefracker), which have a fixed, minimal device
# model. Everything needed to reach userspace is built in.

# Virtio devices exposed over MMIO.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y

# Networking and vsock are the guest's only channels to the host, so keep them
# built in rather than relying on module loading early in boot.
CONFIG_VIRTIO_NET=y
CONFIG_NET_FAILOVER=y
CONFIG_FAILOVER=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
CONFIG_VSOCKETS_LOOPBACK=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_VHOST=y
CONFIG_VHOST_IOTLB=y
CONFIG_VHOST_VSOCK=y

# The remaining options below are built in rather than modular for the same
# reason: the guest should not depend on module loading at runtime.
CONFIG_ACPI_AC=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_THERMAL=y
CONFIG_ASYNC_CORE=y
CONFIG_ASYNC_XOR=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_CRC16=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_XTS=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_DNS_RESOLVER=y
CONFIG_DUMMY=y
CONFIG_EEPROM_93CX6=y
CONFIG_EXT4_FS=y
CONFIG_FS_MBCACHE=y
CONFIG_GRACE_PERIOD=y
CONFIG_HID_GENERIC=y
CONFIG_HWMON=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_TUNNEL=y
CONFIG_INPUT_VIVALDIFMAP=y
CONFIG_IPV6_SIT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_JBD2=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_LLC=y
CONFIG_LOCKD=y
CONFIG_MOUSE_PS2=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NET_IP_TUNNEL=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_OVERLAY_FS=y
CONFIG_PNFS_BLOCK=y
CONFIG_PNFS_FILE_LAYOUT=y
CONFIG_PNFS_FLEXFILE_LAYOUT=y
CONFIG_RPCSEC_GSS_KRB5=y
CONFIG_SERIAL_8250_EXAR=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_SERIO_SERPORT=y
CONFIG_STP=y
CONFIG_SUNRPC=y
CONFIG_SUNRPC_GSS=y
CONFIG_VETH=y
CONFIG_XOR_BLOCKS=y

# Build in the Nitro Secure Module (NSM) driver.
CONFIG_NSM=y

# Build the REDIRECT netfilter targets in rather than ship them as modules.
CONFIG_NFT_REDIR=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y

# Drop the x86 GHASH-CLMULNI module: AES-NI is built in and nothing in the guest
# needs this accelerator, so don't ship it. x86-only symbol; no-op on aarch64.
# CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL is not set

# --- aarch64-effective overlays (kept here so the shared config-bottlerocket-*
# fragments stay identical to kernel-6.18; these are no-ops/ignored on x86_64). ---

# No DMA CMA area. The AL2023 aarch64 base reserves a 64 MiB CMA region
# (CONFIG_CMA_SIZE_MBYTES=64); a virtio-only guest never allocates from it, so
# disable it to return that memory. x86_64 already has DMA_CMA off, so this is a
# no-op there.
# CONFIG_DMA_CMA is not set

# Build the arm64 crypto accelerators in rather than ship them as loadable
# modules (the x86 equivalent, AES-NI, is already built in), and drop the
# non-FIPS SM3/SM4 CE variants. Keeps the guest's crypto out of the loadable
# module set. These symbols don't exist on x86_64 (ignored there). Does not
# enable CONFIG_CRYPTO_FIPS.
CONFIG_CRYPTO_GHASH_ARM64_CE=y
CONFIG_CRYPTO_SHA3_ARM64=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y
CONFIG_CRYPTO_AES_ARM64_BS=y
CONFIG_CRYPTO_AES_ARM64_CE_CCM=y
# CONFIG_CRYPTO_SM3_ARM64_CE is not set
# CONFIG_CRYPTO_SM4_ARM64_CE is not set

