[Unit]
Description=NVIDIA Persistence Daemon
# Ensure persistenced starts after /dev/nvidia* exists
After=nvidia-lts-load-tesla-kernel-modules.service nvidia-lts-load-open-gpu-kernel-modules.service nvidia-lts-load-grid-kernel-modules.service
After=nvidia-fb-load-tesla-kernel-modules.service nvidia-fb-load-open-gpu-kernel-modules.service nvidia-fb-load-grid-kernel-modules.service

[Service]
Type=forking
ExecStart=/usr/bin/nvidia-persistenced --user nvidia --verbose

[Install]
RequiredBy=preconfigured.target
